---
const _props = Astro.props || {};
const title = _props.title || '';
const summary = _props.summary || '';
const link = _props.link || '';
---
<article class="problem">
  <h3>{title}</h3>
  <p>{summary}</p>
  {link ? <a class="btn" href={link}>Read notes</a> : <a class="btn" href="#">Read notes</a>}
</article>
