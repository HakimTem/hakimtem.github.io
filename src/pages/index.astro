---
import Header from '../components/Header.astro'
import ProblemCard from '../components/ProblemCard.astro'
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Hakim — Math · CS · Physics</title>
    <link rel="stylesheet" href="/styles.css" />
  </head>
  <body>
    <Header title="Hakim" />

    <main class="container">
      <section id="about" class="card">
        <h2>About Me</h2>
        <p>
          I'm a Mathematics & Computer Science graduate with a minor in Physics.
          My interests lie at the intersection of rigorous theory and clean
          computation — from pure mathematics and theoretical physics to
          shipping well-engineered Android apps.
        </p>
        <p>
          I enjoy problem-solving that blends abstraction (proofs, formal models)
          with practical constraints (algorithms, performance on-device).
        </p>
        <ul class="skills">
          <li>Interests: Theoretical physics, algebraic geometry, analytic number theory</li>
          <li>Tech: Kotlin/Java (Android), Python, C++</li>
          <li>Tools: Git, Linux, unit testing</li>
        </ul>
      </section>

      <section id="problems" class="card">
        <h2>Selected Problems</h2>
        <p>Short statements and notes on problems I've worked on or find interesting.</p>
        <div class="grid problems-grid">
          <ProblemCard title="Geodesics on negatively curved surfaces" summary="Spectral properties of the Laplacian and links to ergodicity and mixing." />
          <ProblemCard title="Diophantine approximations" summary="Metric results and approximation constants for algebraic numbers." />
          <ProblemCard title="Variational methods in toy QFT" summary="Existence of soliton-like solutions via constrained minimisation." />
          <ProblemCard title="Optimising on-device ML" summary="Model quantisation and algorithmic speedups for Android inference." />
        </div>
      </section>

      <section id="projects" class="card">
        <h2>Android Apps</h2>
        <p>Selected apps I developed, focusing on usability and efficient implementations.</p>
        <ul class="projects">
          <li><strong>MathSketch</strong> — interactive sketches for visualising curves and transformations.</li>
          <li><strong>PhysSim</strong> — physics simulations for exploring mechanics concepts.</li>
        </ul>
      </section>

      <section id="contact" class="card small">
        <h2>Contact</h2>
        <p>Email: <a href="mailto:hemacini@gmail.com">hemacini@gmail.com</a></p>
        <p>GitHub: <a href="https://github.com/hakimtem">github.com/hakimtem</a></p>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© Hakim — Theoretical physics, pure math, Android development.</p>
      </div>
    </footer>
  </body>
</html>
